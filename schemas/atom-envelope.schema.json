{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Beneficial-AI-Foundation/probe/schemas/atom-envelope.schema.json",
  "title": "Probe Atom Envelope",
  "description": "Schema 3.x envelope for probe-* atom files. Atoms branches are keyed on provenance shape (ADR-006): a `source` object marks a single-tool envelope, an `inputs` array marks a composed one — producers may compose under their own schema strings (e.g. probe-aeneas/extract).",

  "oneOf": [
    { "$ref": "#/$defs/singleToolAtomsEnvelope" },
    { "$ref": "#/$defs/singleToolGenericEnvelope" },
    { "$ref": "#/$defs/composedAtomsEnvelope" },
    { "$ref": "#/$defs/mergedGenericEnvelope" }
  ],

  "$defs": {
    "singleToolAtomsEnvelope": {
      "type": "object",
      "description": "Envelope for an atoms-category file with single-tool (`source`) provenance (e.g., probe-verus/atoms, probe-lean/extract, probe-vcvio/extract). data is a dictionary of atoms.",
      "properties": {
        "schema": {
          "type": "string",
          "pattern": "^probe-(rust|lean|verus|aeneas|leanblueprint|vcvio)/(atoms|enriched-atoms|extract)$"
        },
        "schema-version": { "$ref": "#/$defs/schemaVersion" },
        "tool": { "$ref": "#/$defs/tool" },
        "source": { "$ref": "#/$defs/source" },
        "timestamp": { "$ref": "#/$defs/timestamp" },
        "data": { "$ref": "#/$defs/atomDictionary" }
      },
      "required": ["schema", "schema-version", "tool", "source", "timestamp", "data"],
      "additionalProperties": false
    },

    "singleToolGenericEnvelope": {
      "type": "object",
      "description": "Envelope for a single-tool non-atoms file (specs, proofs, stubs, verification-report). data values are not full atoms, so the dictionary is unconstrained.",
      "properties": {
        "schema": {
          "type": "string",
          "pattern": "^probe-(rust|lean|verus|aeneas|leanblueprint)/(specs|proofs|stubs|verification-report)$"
        },
        "schema-version": { "$ref": "#/$defs/schemaVersion" },
        "tool": { "$ref": "#/$defs/tool" },
        "source": { "$ref": "#/$defs/source" },
        "timestamp": { "$ref": "#/$defs/timestamp" },
        "data": { "$ref": "#/$defs/genericDictionary" }
      },
      "required": ["schema", "schema-version", "tool", "source", "timestamp", "data"],
      "additionalProperties": false
    },

    "composedAtomsEnvelope": {
      "type": "object",
      "description": "Envelope for an atoms-category file with composed (`inputs`) provenance: hub merges (probe/merged-atoms), projections (probe/projected-atoms — a view rejected by merge/enrich, ADR-006), and producer-composed extracts (e.g. probe-aeneas/extract). A probe/projected-atoms envelope must carry the projection block.",
      "if": {
        "properties": { "schema": { "const": "probe/projected-atoms" } }
      },
      "then": { "required": ["projection"] },
      "properties": {
        "schema": {
          "type": "string",
          "pattern": "^(probe/(merged|projected)-atoms|probe-(rust|lean|verus|aeneas|leanblueprint|vcvio)/(atoms|enriched-atoms|extract))$"
        },
        "schema-version": { "$ref": "#/$defs/schemaVersion" },
        "tool": { "$ref": "#/$defs/tool" },
        "inputs": {
          "type": "array",
          "description": "Provenance: one entry per input source (≥2 for merge, ≥1 for project).",
          "items": {
            "type": "object",
            "properties": {
              "schema": { "type": "string" },
              "source": { "$ref": "#/$defs/source" }
            },
            "required": ["schema", "source"],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "projection": {
          "type": "object",
          "description": "Present when produced by probe project. Contains projection parameters and statistics.",
          "properties": {
            "mappings-file": { "type": "string" },
            "seeds": { "type": "integer", "minimum": 0 },
            "forward-depth": { "type": "integer", "minimum": 0 },
            "reverse-depth": { "type": "integer", "minimum": 0 },
            "atoms-in": { "type": "integer", "minimum": 0 },
            "atoms-out": { "type": "integer", "minimum": 0 },
            "deps-trimmed": { "type": "integer", "minimum": 0 }
          },
          "required": ["mappings-file", "seeds", "forward-depth", "reverse-depth", "atoms-in", "atoms-out", "deps-trimmed"],
          "additionalProperties": false
        },
        "timestamp": { "$ref": "#/$defs/timestamp" },
        "data": { "$ref": "#/$defs/atomDictionary" }
      },
      "required": ["schema", "schema-version", "tool", "inputs", "timestamp", "data"],
      "additionalProperties": false
    },

    "mergedGenericEnvelope": {
      "type": "object",
      "description": "Envelope for merged specs or proofs produced by probe merge.",
      "properties": {
        "schema": {
          "type": "string",
          "pattern": "^probe/merged-(specs|proofs)$"
        },
        "schema-version": { "$ref": "#/$defs/schemaVersion" },
        "tool": { "$ref": "#/$defs/tool" },
        "inputs": {
          "type": "array",
          "description": "Provenance: one entry per input file that was merged.",
          "items": {
            "type": "object",
            "properties": {
              "schema": { "type": "string" },
              "source": { "$ref": "#/$defs/source" }
            },
            "required": ["schema", "source"],
            "additionalProperties": false
          },
          "minItems": 2
        },
        "timestamp": { "$ref": "#/$defs/timestamp" },
        "data": { "$ref": "#/$defs/genericDictionary" }
      },
      "required": ["schema", "schema-version", "tool", "inputs", "timestamp", "data"],
      "additionalProperties": false
    },

    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "Interchange spec version in <major>.<minor> format."
    },

    "tool": {
      "type": "object",
      "description": "Metadata about the tool that produced this file.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Tool identifier (e.g., \"probe-verus\", \"probe-lean\", \"probe\")."
        },
        "version": {
          "type": "string",
          "description": "Semver version of the tool."
        },
        "command": {
          "type": "string",
          "description": "The command that produced this file (e.g., \"atomize\", \"extract\", \"merge\", \"project\")."
        }
      },
      "required": ["name", "version", "command"],
      "additionalProperties": false
    },

    "source": {
      "type": "object",
      "description": "Metadata about the analyzed project.",
      "properties": {
        "repo": {
          "type": "string",
          "description": "Git remote URL of the analyzed project."
        },
        "commit": {
          "type": "string",
          "description": "Full git commit hash at analysis time."
        },
        "language": {
          "type": "string",
          "enum": ["rust", "lean"],
          "description": "Source language of the analyzed project."
        },
        "package": {
          "type": "string",
          "description": "Package/crate/project name."
        },
        "package-version": {
          "type": "string",
          "description": "Version identifier (semver or short commit hash)."
        }
      },
      "required": ["repo", "commit", "language", "package", "package-version"],
      "additionalProperties": false
    },

    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of when the analysis was run."
    },

    "atomDictionary": {
      "type": "object",
      "description": "Dictionary keyed by code-name URI. Each value is an atom.",
      "additionalProperties": { "$ref": "#/$defs/atom" }
    },

    "genericDictionary": {
      "type": "object",
      "description": "Dictionary keyed by code-name URI for non-atoms categories (specs, proofs, stubs, verification-report). Values are tool-specific entries, not full atoms.",
      "additionalProperties": true
    },

    "atom": {
      "type": "object",
      "description": "A single atom (function, definition, theorem, etc.).",
      "properties": {
        "display-name": {
          "type": "string",
          "description": "Human-readable name."
        },
        "dependencies": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Sorted code-name URIs of referenced atoms."
        },
        "code-module": {
          "type": "string",
          "description": "Module, namespace, or section path."
        },
        "code-path": {
          "type": "string",
          "description": "Relative path to source file. Empty for stubs."
        },
        "code-text": {
          "type": "object",
          "properties": {
            "lines-start": {
              "type": "integer",
              "minimum": 0,
              "description": "First line (1-based). 0 for stubs."
            },
            "lines-end": {
              "type": "integer",
              "minimum": 0,
              "description": "Last line (1-based). 0 for stubs."
            }
          },
          "required": ["lines-start", "lines-end"],
          "additionalProperties": false
        },
        "kind": {
          "type": "string",
          "description": "Declaration kind. Values are language-specific."
        },
        "language": {
          "type": "string",
          "enum": ["rust", "lean", "verus", "blueprint"],
          "description": "Source language of this atom."
        },
        "status-origin": {
          "type": "string",
          "enum": ["translation", "kernel-taint"],
          "description": "Optional evidence marker on verification-status (ADR-006): \"translation\" = imported evidence copied from a corresponding atom in another language (probe-aeneas); \"kernel-taint\" = local evidence reflecting a producer-known negative finding the emitted graph cannot express (probe-lean). Bearing atoms are enrichment blocker seeds."
        },
        "maps-to": {
          "type": "array",
          "items": { "$ref": "#/$defs/correspondenceRecord" },
          "description": "Correspondence records attached by probe merge --mappings on the mapping's from atom (ADR-006, P13/P27): sorted by (target, confidence, method), never written into dependencies, inert to enrichment."
        },
        "mapped-from": {
          "type": "array",
          "items": { "$ref": "#/$defs/correspondenceRecord" },
          "description": "Mirror correspondence records on the mapping's to atom. Mirrors are best-effort: the correspondence relation is the union over maps-to and mapped-from."
        }
      },
      "required": [
        "display-name",
        "dependencies",
        "code-module",
        "code-path",
        "code-text",
        "kind",
        "language"
      ],
      "additionalProperties": true
    },

    "correspondenceRecord": {
      "type": "object",
      "description": "One correspondence assertion: a mappings-file entry linked these code-names with this confidence (ADR-006). Record identity is the (target, confidence, method) triple.",
      "properties": {
        "target": {
          "type": "string",
          "description": "Code-name URI of the corresponding atom (normalized, may dangle)."
        },
        "confidence": {
          "type": "string",
          "enum": ["exact", "exact-disambiguated", "file-and-name", "file-and-lines", "heuristic", "manual"],
          "description": "Mappings-file confidence vocabulary."
        },
        "method": {
          "type": "string",
          "description": "Optional finer matching-method description (e.g. \"rust-qualified-name\"); omitted when absent."
        }
      },
      "required": ["target", "confidence"],
      "additionalProperties": false
    }
  }
}
